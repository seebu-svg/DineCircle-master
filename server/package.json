{
  "name": "dinecircle-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && cp src/schema.sql dist/schema.sql",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration",
    "test:integration": "tsx --test src/tests/*.integration.test.ts",
    "test:unit": "node --import tsx --test src/tests/database_config.test.ts src/tests/db_connect.test.ts src/tests/phase2_security.test.ts src/tests/search_unit.test.ts",
    "db:schema": "tsx src/schema.ts",
    "db:schema:dist": "node dist/schema.js",
    "db:seed": "tsx src/seed.ts",
    "db:seed:karachi": "tsx src/seed_karachi_venues.ts",
    "db:seed:dist": "node dist/seed.js",
    "db:reset": "npm run db:schema && npm run db:seed",
    "db:setup": "npm run db:schema && npm run db:seed",
    "db:setup:dist": "npm run db:schema:dist && npm run db:seed:dist",
    "db:check": "tsx src/check_db.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.16.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
