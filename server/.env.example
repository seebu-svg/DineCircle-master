# DineCircle API — environment template.
# Copy to `.env` and fill real values. NEVER commit `.env`.

# --- Core (required) ---
# Full Postgres connection string used by the `pg` pool. The default targets a
# disposable podman container on port 5433; start it with:
#   podman run -d --name dinecircle-pg \
#     -e POSTGRES_USER=dinecircle \
#     -e POSTGRES_PASSWORD=dinecircle \
#     -e POSTGRES_DB=dinecircle \
#     -p 5433:5432 docker.io/library/postgres:17-alpine
# The role needs CREATEDB because the integration suite creates and drops its
# own throwaway databases (src/tests/util.ts).
DATABASE_URL=postgresql://dinecircle:dinecircle@localhost:5433/dinecircle
# Remote/managed hosts opt into TLS with ?sslmode=require and, when the system
# trust store does not include the issuer, a CA bundle path.
# DATABASE_SSL_CA_FILE=/absolute/path/to/host-ca.pem
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=30000
PORT=4000
NODE_ENV=development

# --- Money path ---
# Platform commission on every gross seat sale (0 < rate < 1). Defaults to 0.10
# and is read once at boot; never client-set. Covers accrual AND recompute.
# PLATFORM_COMMISSION_RATE=0.10
# Rate-limit overrides (positive integers). Defaults: 100/min API, 10/min auth.
# Integration tests raise these; leave unset in production.
# API_RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_MAX=10

# --- Added in later phases (leave commented until wired up) ---
# Phase 4 — Stripe payments (TEST MODE).
# Secret key: server-only, NEVER commit and NEVER paste into the Flutter side.
# A restricted test key (PaymentIntents + Refunds + Webhooks only) is enough.
# STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret — from `stripe listen` output or the dashboard
# endpoint. Required whenever STRIPE_SECRET_KEY is set.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Charge currency for PaymentIntents (test cards are safest with usd).
# STRIPE_CURRENCY=usd
# Gateway mode override for automated tests / demos: 'mock' runs Stripe
# semantics fully offline (deferred settlement + locally signed webhooks).
# Never allowed when NODE_ENV=production. Unset = stripe if a key exists,
# otherwise the historical simulated gateway (instant settlement, no calls).
# PAYMENTS_MODE=mock
# Flutter needs the PUBLISHABLE key separately at build time:
#   flutter run --dart-define=STRIPE_PUBLISHABLE_KEY=pk_test_...
# Phase 6 — Stripe Connect (host payouts)
# STRIPE_CONNECT_CLIENT_ID=...
# Phase 7 — Firebase Cloud Messaging (push)
# FCM_SERVER_KEY=...
# GOOGLE_APPLICATION_CREDENTIALS=
# Phase 5 — Google Maps (server-side geocoding)
# GOOGLE_MAPS_API_KEY=

# Reverse proxy: forwarded client IP headers are ignored by default.
# Set only for your actual proxy topology (IP/subnet preferred).
# TRUST_PROXY=loopback
# TRUST_PROXY=1  # one trusted proxy hop; prevent direct access to the API port
