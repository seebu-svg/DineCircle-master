<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash (API 31+) in dark mode.
         Dark mode is a higher-priority qualifier than the platform version, so
         values-v31 alone would be ignored on a dark One UI device without this
         night variant. Parents stay AppCompat-descendant for flutter_stripe. -->
    <style name="LaunchTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/dinecircle_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/dinecircle_bg</item>
    </style>
</resources>
