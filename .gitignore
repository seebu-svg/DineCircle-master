migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local build-time config (Stripe publishable + Google Maps keys) — see
# dart-defines.example.json. Keeps keyless CI/widget tests dormant.
# dart-defines.json holds the production host; dart-defines.local.json holds a
# throwaway LAN/tunnel host written by tmp-live/up.sh. Neither is committed.
dart-defines.json
dart-defines.local.json

# Local secrets
.env
.env.*
!.env.example

# Scratch workspace for one-off migration/maintenance scripts
.tmp/
.tmpx/

# Local APK-unpacking probe and QA screenshots (throwaway artifacts)
/.apk_probe/
/.qa/
/server/.qa/
